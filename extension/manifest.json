{
  "manifest_version": 3,
  "name": "Last.fm Hub",
  "short_name": "Last.fm Hub",
  "version": "2.17.0",
  "description": "Last.fm num hub preto e moderno: barra lateral, balões, catálogo de gêneros, recomendações premium e afinidade com amigos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Last.fm Hub",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.freetls.fastly.net/*",
    "https://nominatim.openstreetmap.org/*",
    "https://*.basemaps.cartocdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.last.fm/*",
        "https://last.fm/*"
      ],
      "css": [
        "vendor/leaflet.css",
        "content/theme.css"
      ],
      "js": [
        "vendor/leaflet.js",
        "content/app.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120"
}
